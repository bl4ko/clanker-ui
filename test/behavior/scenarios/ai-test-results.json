{
  "url": "https://ui.shadcn.com/docs/ai-elements/base/test-results",
  "preview": 1,
  "note": "The docs example uses the base-rhea style; behavior does not depend on it, and no step compares sizes.",
  "parts": {
    "trigger": {
      "role": "button",
      "name": "Ran 8 tests, 2 failed, 1 skipped"
    },
    "suite": {
      "role": "button",
      "name": "auth.test.ts, 3 tests"
    },
    "content": {
      "slot": "trace-collapsible-content",
      "optional": true
    }
  },
  "anchor": "trigger",
  "positions": [],
  "steps": [
    {
      "do": "tab_in"
    },
    {
      "do": "tab",
      "label": "first suite"
    },
    {
      "do": "press",
      "key": "Enter",
      "motion": "content"
    },
    {
      "do": "press",
      "key": "Space",
      "motion": "content",
      "label": "close the suite"
    },
    {
      "do": "click",
      "target": "trigger",
      "motion": "content"
    },
    {
      "do": "click",
      "target": "trigger",
      "motion": "content",
      "label": "click again"
    }
  ]
}
