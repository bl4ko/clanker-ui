{
  "url": "https://ui.shadcn.com/docs/ai-elements/base/context",
  "note": "AI Elements pattern: a hover card on a button with a progress bar. The live example uses the base-rhea style.",
  "parts": {
    "trigger": {"role": "button", "name": "8% context"},
    "card": {"slot": "hover-card-content", "popup": true},
    "bar": {"role": "progressbar", "in": "page"}
  },
  "steps": [
    {"do": "hover", "target": "trigger", "motion": "card", "ms": 900},
    {"do": "hover", "target": "card", "steps": 6, "motion": "card", "ms": 900},
    {"do": "leave", "motion": "card", "ms": 900},
    {"do": "tab_in", "motion": "card", "ms": 900},
    {"do": "press", "key": "Escape", "motion": "card", "ms": 700},
    {"do": "tab", "motion": "card", "ms": 900}
  ]
}
