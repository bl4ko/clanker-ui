{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions after a renovate comment in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Za-z_-]+: \"?(?<currentValue>\\d[^\"\\s]*)\"?",
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\s+[A-Za-z_-]+: \\S+?:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Versions of the shadcn pin (tools/parity/refapp.py --update-lock)",
      "matchFileNames": ["tools/parity/refapp/**"],
      "enabled": false
    },
    {
      "groupName": "playwright",
      "matchPackageNames": ["playwright"]
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true
    }
  ]
}
