{
  "url": "https://ui.shadcn.com/docs/ai-elements/base/inline-citation",
  "note": "AI Elements pattern: hover cards on secondary xs buttons inside the sentences. The live example uses the base-rhea style. Every step uses the first citation, so the card position is against its own trigger.",
  "allowed": [
    {"key": "ai-inline-citation.rhea-card-size", "match": "^card end size \\| (\\d+)x\\d+ \\| \\1x\\d+ ", "reason": "the live example is base-rhea: hover-card-content p-4 (Nova p-2.5) gives the text less width and the card more height; the kit is Nova"}
  ],
  "parts": {
    "trigger": {"role": "button", "name": "nextjs.org", "nth": 0},
    "card": {"slot": "hover-card-content", "popup": true}
  },
  "steps": [
    {"do": "hover", "target": "trigger", "motion": "card", "ms": 900},
    {"do": "leave", "motion": "card", "ms": 900},
    {"do": "hover", "target": "trigger", "motion": "card", "ms": 900, "label": "hover again"},
    {"do": "hover", "target": "card", "steps": 6, "motion": "card", "ms": 900},
    {"do": "leave", "motion": "card", "ms": 900, "label": "leave the card"},
    {"do": "tab_in", "motion": "card", "ms": 900},
    {"do": "press", "key": "Escape", "motion": "card", "ms": 700},
    {"do": "shift_tab", "motion": "card", "ms": 700},
    {"do": "tab", "motion": "card", "ms": 900, "label": "tab back to the trigger"}
  ]
}
